DATABASE_URL=postgresql+psycopg2://ml_lab_user:ml_lab_pass@localhost:5432/ml_virtual_lab

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ENV=development
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Leave EMAIL_ENABLED=false for local dev: generated passwords are printed to
# the backend console instead of being sent. Set true + fill in SMTP details
# for staging/production.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ML Virtual Lab <noreply@example.com>"
SMTP_USE_TLS=true
